# ---- Leash (Shannon testnet, chain 50312) ----
# Never commit the real .env. Two distinct keys, deliberately.

# Delegator = the "fund key". Holds collateral, grants + revokes the mandate.
DELEGATOR_PRIVATE_KEY=

# Delegate = the "operator key". Trades. Must never be able to move funds.
DELEGATE_PRIVATE_KEY=

NETWORK=testnet
RPC_URL=https://dream-rpc.somnia.network
CHAIN_ID=50312
EXPLORER=https://shannon-explorer.somnia.network
REST_URL=https://stg.api.dreamdex.io/v0

# Event Contract venue. VERIFIED MOVING — re-read from a live market if markets vanish.
# Source: dreamdex-bot-kit docs/event-contracts.md (testnet value, early Aug 2026).
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

